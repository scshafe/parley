# Names only, for humans: no tool reads this file. Values are placed on the host
# by the owner's provisioning (`stack env-set parley NAME`), never committed.
TS_AUTHKEY=                  # one-off, single-use, tagged tag:parley (first join only)
OIDC_CLIENT_ID=              # the door's Pocket ID client: parley (confidential, PKCE)
OIDC_CLIENT_SECRET=
ID_TAILNET_IP=               # the id node's tailscale IPv4
VOICE_LAB_TAILNET_IP=        # the voice-lab node's tailscale IPv4
OPENCLAW_TAILNET_IP=         # the OpenClaw gateway node's tailscale IPv4
PARLEY_OWNER_SUBJECT=        # the owner's Pocket ID user id (the relay's one allowed subject)
# Optional (owner):
PARLEY_APNS_KEY_ID=          # the APNs auth key's id (10 characters); with the team id and
PARLEY_APNS_TEAM_ID=         #   state/secrets/apns-key.p8, push is on
PARLEY_APNS_ENV=             # sandbox (default; an Xcode debug build) or production
PARLEY_OPENCLAW_AGENT_ID=    # a dedicated OpenClaw agent (default: the gateway's default)
# OAUTH2_PROXY_COOKIE_SECRET is generated on the host
# PARLEY_IMAGE is written by each deploy (the pin)
# The relay's secret files (state/secrets, not .env): openclaw-gateway-token,
# voicelab-client-secret, voicelab-webhook-secret, apns-key.p8 (optional).
